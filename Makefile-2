# ============================================================

GREEN=\033[0;32m
RED=\033[0;31m
YELLOW=\033[1;33m
BLUE=\033[0;34m
CYAN=\033[0;36m
NC=\033[0m

# ============================================================
#   CONFIGURATION DES CHEMINS
# ============================================================
PATHS_CONF := /opt/KING-AO/KING-AO/config/paths.conf

EPARVIER_ROOT := $(shell grep "^EPARVIER=" $(PATHS_CONF) | cut -d '=' -f2)
KINGDOMAINE_ROOT := $(shell grep "^KINGDOMAINE=" $(PATHS_CONF) | cut -d '=' -f2)
METIER_ROOT := $(shell grep "^METIER=" $(PATHS_CONF) | cut -d '=' -f2)
PORTAL_ROOT := $(shell grep "^PORTAL=" $(PATHS_CONF) | cut -d '=' -f2)

LOG_DIR := /opt/KING-AO/logs/builds
TAG ?= $(shell git rev-parse --short HEAD)

# ============================================================
#   AIDE / MENU
# ============================================================
help:
    @echo -e "$(CYAN)===== KING-AO DevOps Toolkit =====$(NC)"
    @echo -e "$(GREEN)make all$(NC)                  → Build TOUT KING-AO"
    @echo -e "$(GREEN)make api$(NC)                  → Build EPARVIER API"
    @echo -e "$(GREEN)make cockpit$(NC)              → Build EPARVIER Cockpit"
    @echo -e "$(GREEN)make metier$(NC)               → Build METIER"
    @echo -e "$(GREEN)make kingdomaine$(NC)          → Build KINGDOMAINE"
    @echo -e "$(GREEN)make portal$(NC)               → Build PORTAL"
    @echo ""
    @echo -e "$(GREEN)make start-core$(NC)           → Démarre API + Cockpit + Mongo"
    @echo -e "$(GREEN)make restart-core$(NC)         → Redémarre API + Cockpit"
    @echo -e "$(GREEN)make logs-api$(NC)             → Logs API"
    @echo -e "$(GREEN)make logs-cockpit$(NC)         → Logs Cockpit"
    @echo ""
    @echo -e "$(GREEN)make compose-up$(NC)           → docker compose up -d"
    @echo -e "$(GREEN)make compose-down$(NC)         → docker compose down"
    @echo -e "$(GREEN)make compose-rebuild$(NC)      → Rebuild complet"
    @echo ""
    @echo -e "$(GREEN)make debug$(NC)                → Build verbeux"
    @echo -e "$(GREEN)make clean-all$(NC)            → Nettoyage total Docker"
    @echo -e "$(GREEN)make hard-reset$(NC)           → Reset complet du Docker Engine"
    @echo -e "$(CYAN)====================================$(NC)"

# ============================================================
#   BUILD MODULES KING-AO
# ============================================================
api:
    @mkdir -p $(LOG_DIR)
    @echo -e "$(BLUE)[BUILD] API — TAG=$(TAG)$(NC)"
    cd:$(TAG) -f $(EPARVIER_ROOT)/SolaizeApi/Dockerfile $(EPARVIER_ROOT) | tee $(LOG_DIR)/api_$(TAG).
    
cockpit:
    @mkdir -p $(LOG_DIR)
    @echo -e "$(BLUE)[BUILD] Cockpit — TAG=$(TAG)$(NC)"
    docker build -t solaizecockpit:$(TAG) -f $(EPARVIER_ROOT)/SolaizeCockpit/Dockerfile $(EPARVIER_ROOT) | tee $(LOG_DIR)/cockpit_$(TAG).log

metier:
    @mkdir -p $(LOG_DIR)
    @echo -e "$(BLUE)[BUILD] METIER — TAG=$(TAG)$(NC)"
    docker build -t metier:$(TAG) -f $(METIER_ROOT)/Dockerfile $(METIER_ROOT) | tee $(LOG_DIR)/metier_$(TAG).log

kingdomaine:
    @mkdir -p $(LOG_DIR)
    @echo -e "$(BLUE)[BUILD] KINGDOMAINE — TAG=$(TAG)$(NC)"
    docker build -t kingdomaine:$(TAG) -f $(KINGDOMAINE_ROOT)/Dockerfile $(KINGDOMAINE_ROOT) | tee $(LOG_DIR)/kingdomaine_$(TAG).log

portal:
    @mkdir -p $(LOG_DIR)
    @echo -e "$(BLUE)[BUILD] PORTAL — TAG=$(TAG)$(NC)"
    docker build -t portal:$(TAG) -f $(PORTAL_ROOT)/Dockerfile $(PORTAL_ROOT) | tee $(LOG_DIR)/portal_$(TAG).log

# ============================================================
#   BUILD GLOBAL
# ============================================================
all: api cockpit metier kingdomaine portal
    @echo -e "$(GREEN)[OK] Build complet KING-AO terminé.$(NC)"

# ============================================================
#   MODE DEBUG
# ============================================================
debug:
    @echo -e "$(YELLOW)[DEBUG] Build verbeux activé$(NC)"
    DOCKER_BUILDKIT=0 make all

# ============================================================
#   CONTENEURS EPARVIER
# ============================================================
start-core:
    docker start mongo || true
    docker start solaizeapi || true
    docker start solaizecockpit || true

restart-core:
    docker stop solaizeapi || true
    docker stop solaizecockpit || true
    docker start solaizeapi || true
    docker start solaizecockpit || true

logs-api:
    docker logs solaizeapi -f

logs-cockpit:
    docker logs solaizecockpit -f

# ============================================================
#   DOCKER COMPOSE
# ============================================================
compose-up:
    docker compose up -d

compose-down:
    docker compose down

compose-rebuild:
    docker compose build --no-cache

# ============================================================
#   DOTNET LOCAL RUN
# ============================================================
run-api:
    cd /opt/KING-AO/modules/EPARVIER/api && dotnet run

run-cockpit:
    cd /opt/KING-AO/modules/EPARVIER/cockpit && dotnet run

# ============================================================
#   NETTOYAGE DOCKER
# ============================================================
clean-all:
    docker system prune -a --volumes -f

hard-reset:
    docker stop $$(docker ps -aq) || true
    docker system prune -a --volumes -f



