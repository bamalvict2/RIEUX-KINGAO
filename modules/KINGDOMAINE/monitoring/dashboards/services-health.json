{
  "title": "EPARVIER - Services Health",
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "API (.NET) - 5010",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox_api\", instance=\"http://localhost:5010/health\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Blazor Server - 5110",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox_api\", instance=\"http://localhost:5110\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "MongoDB",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mongodb_up{job=\"mongodb_exporter\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Prometheus",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"prometheus\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Grafana",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"grafana\"}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "API Latency",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox_api\"}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP Status Codes",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_http_status_code{job=\"blackbox_api\"}"
        }
      ]
    }
  ]
}
