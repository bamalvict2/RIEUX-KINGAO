# KINGDOMAINE — .dockerignore cockpitifié

# Monitoring build artifacts
bin/
obj/

# Logs
logs/
*.log

# Cache / runtime
cache/
state/
runtime/
tmp/
*.tmp

# Docker volumes / data
docker-data/
dump/
volumes/

# Secrets
*.env
.env.*
*.key
*.pem
id_ed25519
id_rsa

# Editor / OS
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
