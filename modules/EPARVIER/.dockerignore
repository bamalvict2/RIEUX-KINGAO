# ============================
# EPARVIER — .dockerignore cockpitifié
# ============================

# --- Dotnet build artifacts ---
bin/
obj/
*.pdb
*.mdb
*.db

# --- User / Editor files ---
.vscode/
*.user
*.suo
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
log/
*.tmp

# --- Environment / Secrets ---
*.env
.env.*
appsettings.Development.json
appsettings.Local.json
*.secret.json

# --- Docker volumes / data ---
mongo_data/
docker-data/
dump/

# --- Node / Frontend ---
node_modules/
dist/
build/

# --- Publish output ---
publish/

# --- SSH keys ---
SolaizeEparvier
*.key
*.pem
id_ed25519
id_rsa
